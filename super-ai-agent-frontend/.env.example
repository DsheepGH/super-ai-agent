# ============================================================
# 前端接口地址（Vite 构建时注入）
# ============================================================
# 开发环境：保持 /api，由 Vite 代理到本地后端，浏览器不会跨域。
# 生产环境：保持 /api，由 Nginx 把 /api/ 反向代理到后端。
# 只有前后端分域名部署时，才改成完整地址，例如：
# VITE_API_BASE_URL=https://api.example.com/api
VITE_API_BASE_URL=/api

# 仅开发环境使用：Vite 把 /api 代理到本地 Spring Boot 服务。
VITE_DEV_PROXY_TARGET=http://localhost:8123
